# Downloaded by scripts/download.sh, not tracked.
/server.jar
/libraries/
/versions/

# Local config with secrets; create it with scripts/init-config.sh
/server.properties

# Runtime data. The world is tracked so a clone can restore the server.
/logs/
/crash-reports/
/backups/
/usercache.json
/usernamecache.json
/world/session.lock

# Local-only scratch
*.log

# Python bytecode
__pycache__/
*.pyc
